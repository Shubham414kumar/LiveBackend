# ===========================================================================
# SentinelAI backend configuration
# ===========================================================================
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#
#     cp .env.example .env
#
# Anything left blank falls back to the default in app/core/config.py. In
# production the process validates this file on boot and REFUSES TO START if a
# required value is missing or insecure — a loud failure at deploy time instead
# of a quiet one in front of users.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# development | test | staging | production
ENVIRONMENT=development
SERVICE_NAME=sentinelai-api
# Surfaced in /api/health and in the outbound User-Agent. Set to the git SHA in CI.
RELEASE=dev
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# json for aggregators (production), console for readable local output
LOG_FORMAT=console

# ---------------------------------------------------------------------------
# Datastore — Supabase
# ---------------------------------------------------------------------------
# REQUIRED in production. Without these, favourites, community reports and push
# tokens return 503; every read-only endpoint keeps working.
#
# SUPABASE_KEY must be the `service_role` key, not the anon key. The schema in
# migrations/0001_initial_schema.sql enables Row Level Security with no policies,
# which denies the anon key everything — that is what makes a leaked anon key
# harmless. service_role bypasses RLS. Never ship this key to a client.
#
# Apply the schema once before first boot:
#     psql "$DATABASE_URL" -f migrations/0001_initial_schema.sql
#     psql "$DATABASE_URL" -f migrations/0002_alert_delivery.sql
# or paste those files into the Supabase SQL editor, in that order.
SUPABASE_URL=
SUPABASE_KEY=

# ---------------------------------------------------------------------------
# Redis — cache and distributed rate limiting
# ---------------------------------------------------------------------------
# Optional but strongly recommended with more than one worker or replica.
# Without it, caching and rate limits are per-process, so N workers means N
# times the configured request allowance and N times the upstream API traffic.
# docker-compose provides this automatically.
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Upstream data providers
# ---------------------------------------------------------------------------
# REQUIRED in production. Free key: https://aqicn.org/data-platform/token/
# Server-side only. Map tiles are proxied through this API so the token is
# never shipped to a client.
WAQI_TOKEN=

# Optional. Without it the AI endpoints return 503 "feature unavailable"
# instead of failing. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# REQUIRED in production, and not optional in spirit: the OpenStreetMap
# Nominatim and Overpass usage policies require a contactable User-Agent.
# A generic UA is grounds for having your IP blocked.
CONTACT_EMAIL=
PUBLIC_APP_URL=https://sentinelai.app

# ---------------------------------------------------------------------------
# HTTP surface
# ---------------------------------------------------------------------------
# Comma-separated. MUST be explicit origins in production; "*" is rejected on
# boot. Credentialed CORS is enabled automatically once this is not "*",
# because the CORS spec forbids wildcard + credentials together.
# Expo Go and native builds send no Origin header, so they are unaffected;
# this list is for the admin dashboard and any browser client.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Comma-separated hostnames. MUST be explicit in production: "*" allows
# Host-header injection, which poisons absolute URLs and password-reset links.
TRUSTED_HOSTS=*

# Interactive API docs at /api/docs. Defaults to on outside production and off
# in production. Setting this to true in production is refused on boot.
ENABLE_DOCS=

# Strict-Transport-Security. Defaults to on in production only. Leave off
# locally or the browser will pin localhost to HTTPS.
ENABLE_HSTS=

# Set only when mounted under a path prefix by a reverse proxy, e.g. /api/v2.
ROOT_PATH=

# How many reverse-proxy hops to trust when reading X-Forwarded-For.
#   0 = trust nothing, use the socket peer address (correct default)
#   1 = one proxy you control sits in front (typical: nginx, a load balancer)
# Getting this wrong lets a client forge a new IP per request and bypass rate
# limiting completely, so only raise it if a proxy really is in front.
TRUSTED_PROXY_HOPS=0

# ---------------------------------------------------------------------------
# Admin dashboard auth
# ---------------------------------------------------------------------------
# All three must be set for the admin dashboard to work. If any is missing,
# every /api/admin/* route returns 503 "feature unavailable" — the dashboard is
# off, not open.
ADMIN_USERNAME=

# A bcrypt HASH, never a plaintext password. Generate one:
#     python -c "from app.core.admin_auth import hash_password; print(hash_password('your-password'))"
# The value starts with $2b$ and contains no plaintext.
ADMIN_PASSWORD_HASH=

# Minimum 32 characters in production; shorter is refused on boot. Generate:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_JWT_SECRET=

# Session lifetime, 5-1440 minutes.
ADMIN_TOKEN_TTL_MINUTES=60

# ---------------------------------------------------------------------------
# Outbound HTTP tuning
# ---------------------------------------------------------------------------
HTTP_TIMEOUT_SECONDS=12
HTTP_MAX_CONNECTIONS=100
HTTP_MAX_KEEPALIVE=20
# Retries apply only to timeouts, connection errors and 429/5xx, with
# exponential backoff and jitter. Never to 4xx.
HTTP_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# Cache TTLs, in seconds
# ---------------------------------------------------------------------------
# Matched to how often each upstream actually changes. Raising these reduces
# upstream load and cost; lowering them increases data freshness.
CACHE_TTL_AQI=300
CACHE_TTL_DISASTERS=600
CACHE_TTL_WEATHER=600
# Geocoding and hospital lookups are effectively static, and Nominatim/Overpass
# are the two providers with the strictest rate policies, so cache them hard.
CACHE_TTL_GEOCODE=86400
CACHE_TTL_HOSPITALS=86400
CACHE_TTL_AI=1800
# Entry ceiling for the in-memory fallback cache. Bounded on purpose: the
# previous implementation used unbounded dicts that grew until the process was
# OOM-killed.
CACHE_MAX_ENTRIES=5000

# ---------------------------------------------------------------------------
# Rate limits — requests per window, per client
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
# Cheap cached reads: AQI, disasters, weather.
RATE_LIMIT_READ=120
# Writes: reports, favourites, votes.
RATE_LIMIT_WRITE=20
# AI endpoints — each call costs real money, so this is deliberately tight.
RATE_LIMIT_AI=10
# Admin login attempts, to make credential stuffing impractical.
RATE_LIMIT_AUTH=5

# ---------------------------------------------------------------------------
# Push alerts
# ---------------------------------------------------------------------------
# Read by both the API (which registers tokens and serves preferences) and the
# dispatch worker (`python -m app.worker`), which is a separate process running
# the same image and the same env file.
#
# Off by default, and deliberately so: enabling this sends real notifications to
# real phones from whatever data the configured environment happens to hold. A
# staging database restored from a production dump would page every user. It also
# requires Supabase — tokens, preferences and the delivery ledger all live there —
# so in production PUSH_ENABLED=true without SUPABASE_URL is refused on boot, and
# in any environment the worker refuses to start rather than start up healthy and
# then abort every pass forever.
#
# Apply the delivery schema before enabling:
#     psql "$DATABASE_URL" -f migrations/0002_alert_delivery.sql
PUSH_ENABLED=false

# Optional, and recommended. Expo accepts unauthenticated sends for most
# projects, but a push token is extractable from the app bundle, so without a
# token anyone holding one can send notifications that appear to come from us.
# Required once "enhanced security for push notifications" is on for the project.
# Create one at https://expo.dev/accounts/[account]/settings/access-tokens
# Server-side only. Never ship this to a client.
EXPO_ACCESS_TOKEN=

# How often a dispatch pass runs, 60-21600 seconds. Ignored by `--once`.
PUSH_DISPATCH_INTERVAL_SECONDS=900

# How far back each pass looks for events, 1-168 hours. Longer than the interval
# on purpose: a crashed pass, a deploy or an upstream outage must not leave a
# permanent gap. Re-examining an event costs nothing — the sent_alerts ledger
# makes the second look a no-op.
PUSH_LOOKBACK_HOURS=24

# Threshold applied to devices that have not chosen one. Must be one of
# Low | Minor | Moderate | Severe | Extreme, and must match the column default
# in migrations/0002_alert_delivery.sql.
PUSH_DEFAULT_MIN_SEVERITY=Moderate

# Severity that overrides a device's quiet hours. Someone asleep at 3 a.m. still
# wants to know about a tsunami — that is the difference between a notification
# setting and a safety product. Same vocabulary as above.
PUSH_QUIET_HOURS_BREAKTHROUGH=Severe

# Attempts per (device, event) before it is abandoned, 1-10. The failures worth
# retrying are transient; a fourth attempt at a token Expo has retired is noise.
PUSH_MAX_ATTEMPTS=3

# Devices per page of the dispatch walk, 1-500. Expo's own limit is 100
# notifications per request, so 100 keeps a page close to one upstream request.
PUSH_BATCH_SIZE=100

# The volume cap, 1-20, and the most important number in this section. One
# favourite with a wide radius during an active earthquake sequence can match
# dozens of events that each individually deserve a notification. Delivered as
# dozens of notifications, the user mutes the app — and then hears nothing about
# the one that mattered.
PUSH_MAX_PER_DEVICE_PER_PASS=3

# Retention for the delivery ledger, 1-365 days. Swept by the worker roughly
# daily, and by the database's own prune_old_data() as a backstop.
SENT_ALERTS_RETENTION_DAYS=30
