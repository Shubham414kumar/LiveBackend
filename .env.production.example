# Copy these names into the production secret manager. Never commit real values.
ENVIRONMENT=production
RELEASE=replace-with-git-sha

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=replace-with-server-side-service-role-key
REPORT_IMAGE_BUCKET=report-images
REPORT_IMAGE_URL_TTL_SECONDS=900

WAQI_TOKEN=replace-with-waqi-token
CONTACT_EMAIL=ops@example.com
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
PUBLIC_APP_URL=https://your-public-app.example
ALLOWED_ORIGINS=https://admin.your-public-app.example
TRUSTED_HOSTS=api.your-public-app.example,admin.your-public-app.example
ENABLE_DOCS=false
ENABLE_HSTS=true

ADMIN_USERNAME=replace-with-admin-name
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash
ADMIN_JWT_SECRET=replace-with-at-least-32-random-characters

REDIS_URL=redis://redis:6379/0
PUSH_ENABLED=false
# Set true only after the push worker and delivery migrations are verified.
EXPO_ACCESS_TOKEN=
