ENVIRONMENT=development
SERVICE_NAME=sentinelai-api-local
RELEASE=local
LOG_LEVEL=INFO
LOG_FORMAT=console

# Local development intentionally starts without external credentials.
SUPABASE_URL=
SUPABASE_KEY=
WAQI_TOKEN=
CONTACT_EMAIL=dev@example.invalid
PUBLIC_APP_URL=http://localhost:8000

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
TRUSTED_HOSTS=localhost,127.0.0.1
ENABLE_DOCS=true
ENABLE_HSTS=false
TRUSTED_PROXY_HOPS=0

PUSH_ENABLED=false
RATE_LIMIT_ENABLED=false
